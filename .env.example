# Production Environment Variables
# Copy this file to .env.production and update the values

# Backend
NODE_ENV=production
MONGODB_URI=mongodb://mongodb:27017/slider
CORS_ORIGIN=*
PORT=3023

# Frontend build-time variables (used during docker build)
VITE_API_URL=http://localhost:3023

# --- Auth (Better Auth) ---
# Secret de signature (obligatoire). Générer : openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- SSO providers (activés uniquement si les deux clés sont présentes) ---
# Google  — callback: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft — callback: {BETTER_AUTH_URL}/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# GitHub — callback: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
