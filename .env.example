# Production Environment Variables
# Copy this file to .env.production and update the values

# Backend
NODE_ENV=production
MONGODB_URI=mongodb://mongodb:27017/slider
CORS_ORIGIN=*
PORT=3023

# The reverse proxies in front of the server: how many (1 behind a single
# nginx, Traefik or load balancer), or their addresses ("loopback",
# "10.0.0.0/8"). The client's address, which the sign-in rate limits key on,
# is then read from X-Forwarded-For past them. Leave empty when clients
# connect to the server directly: the header is anyone's to write.
TRUST_PROXY=

# Public origin of the deployed app, in https — required in production: the
# server refuses to start without it. Links in emails, SSO callbacks and MCP
# download URLs are built from it; without it, from each request's Host
# header, which anyone can forge.
PUBLIC_APP_URL=http://localhost:3023

# Frontend build-time variable — dev only.
# In prod the frontend is served by the backend on the same origin and uses
# relative URLs, so this can be omitted from the production build.
# VITE_API_URL=http://localhost:3023

# --- Auth (Better Auth) ---
# Signing secret (required). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Administration ---
# The administrator's address. The account with it is given the admin role
# once its address is verified. Create it after the first start with
#   npm run admin:reset-password --workspace=@imprime/backend
# which prints its password, or sign in with a single sign-on provider that
# vouches for the address; signing up with it is refused. The
# administrator manages the instance from Administration in the app: fonts,
# email (SMTP server, address verification), single sign-on and access, none
# of which is configured here. Their secrets are stored encrypted with
# BETTER_AUTH_SECRET: changing it means entering them again.
# The role stays in the database: changing this address demotes no one. To
# leave this account as the only administrator, once the server runs with the
# new value:
#   npm run admin:demote-others --workspace=@imprime/backend
# If the administrator cannot sign in any more, whoever runs the server can
# give this account a new password (it is created if missing):
#   npm run admin:reset-password --workspace=@imprime/backend
ADMIN_EMAIL=
