# Environment of an Imprime server.
# With docker-compose.yml: copy this file to .env beside it and fill it in;
# the compose file sets NODE_ENV and PORT itself. See doc/self-hosting.md.

# The image docker-compose.yml runs. Empty: the published one,
# ghcr.io/remidufeu/imprime:latest. `imprime-app` runs one built here with
# `npm run docker:build`.
IMPRIME_IMAGE=

# Backend
NODE_ENV=production
# A replica set (Atlas is one) or a single mongod: on a replica set, account
# changes run in transactions; on a single server they cannot, and run
# without (see doc/authentication.md, MongoDB). Empty: docker-compose.yml
# uses the MongoDB it runs. Required with docker-compose.external-mongodb.yml,
# which refuses to start without it.
MONGODB_URI=
PORT=3023

# Other origins whose pages may call the API with a user's session,
# comma-separated. Empty: only the app's own, PUBLIC_APP_URL — all the editor
# needs. "*" is refused in production.
CORS_ORIGIN=

# The reverse proxies in front of the server: how many (1 behind a single
# nginx, Traefik or load balancer), or their addresses ("loopback",
# "10.0.0.0/8"). The client's address, which the sign-in rate limits key on,
# is then read from X-Forwarded-For past them. Leave empty when clients
# connect to the server directly: the header is anyone's to write.
# docker-compose.yml takes 1 when this is empty: it serves the app to this
# machine only, for the proxy in front.
TRUST_PROXY=

# Public origin of the deployed app, in https — required in production: the
# server refuses to start without it. Links in emails, SSO callbacks and MCP
# download URLs are built from it; without it, from each request's Host
# header, which anyone can forge.
PUBLIC_APP_URL=http://localhost:3023

# --- PDF export ---
# How many PDFs the server renders at once, overall and per user — the
# preview_template MCP tool's page images included, drawn in the same job.
# Each render runs on a worker thread of its own, on its own CPU core, and the
# worker holds 150 to 200 MB of memory while it lives (closed after a minute
# without work): set MAX_PDF_RENDERS to no more than the server's cores, nor
# more workers than its memory holds.
# Whole numbers of 1 or more; empty, 4 and 2.
MAX_PDF_RENDERS=
MAX_PDF_RENDERS_PER_USER=

# Past either cap, an export waits for a worker, first come first served:
# PDF_QUEUE_SIZE exports at most (0: none, refused at once), each for
# PDF_QUEUE_WAIT_SECONDS at most (1 to 300). A user may also have no more
# exports waiting than MAX_PDF_RENDERS_PER_USER. An export that cannot wait,
# or waits too long, is answered with 429 EXPORT_BUSY.
# Empty, 10 and 10.
PDF_QUEUE_SIZE=
PDF_QUEUE_WAIT_SECONDS=

# How long, in seconds, a render may run once its worker has it before it is
# stopped — its worker terminated — and the export answered with 408: from 1
# to 300; empty, 30. A request lasts up to the wait above plus this: a proxy
# in front may cut it sooner (nginx: proxy_read_timeout, 60 s by default).
PDF_RENDER_TIMEOUT_SECONDS=

# Frontend build-time variable — dev only.
# In prod the frontend is served by the backend on the same origin and uses
# relative URLs, so this can be omitted from the production build.
# VITE_API_URL=http://localhost:3023

# --- Auth (Better Auth) ---
# Signing secret (required). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Administration ---
# The administrator's address. The account with it is given the admin role
# once its address is verified. Create it after the first start with
#   npm run admin:reset-password --workspace=@imprime/backend
# which prints its password, or sign in with a single sign-on provider that
# vouches for the address; signing up with it is refused. The
# administrator manages the instance from Administration in the app: fonts,
# email (SMTP server, address verification), single sign-on and access, none
# of which is configured here. Their secrets are stored encrypted with
# BETTER_AUTH_SECRET: changing it means entering them again.
# The role stays in the database: changing this address demotes no one. To
# leave this account as the only administrator, once the server runs with the
# new value:
#   npm run admin:demote-others --workspace=@imprime/backend
# If the administrator cannot sign in any more, whoever runs the server can
# give this account a new password (it is created if missing):
#   npm run admin:reset-password --workspace=@imprime/backend
ADMIN_EMAIL=
