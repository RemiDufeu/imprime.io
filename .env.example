# Production Environment Variables
# Copy this file to .env.production and update the values

# Backend
NODE_ENV=production
MONGODB_URI=mongodb://mongodb:27017/slider
CORS_ORIGIN=*
PORT=3023

# Frontend build-time variables (used during docker build)
VITE_API_URL=http://localhost:3023

# --- Auth (Better Auth) ---
# Signing secret (required). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- SSO providers (enabled only when both keys are present) ---
# Google  — callback: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft — callback: {BETTER_AUTH_URL}/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# GitHub — callback: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email verification ---
# Requires SMTP configured below. Set to "true" to enforce verification.
REQUIRE_EMAIL_VERIFICATION=false

# --- SMTP (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
