{
  "name": "@imprime/backend",
  "version": "1.0.0",
  "description": "Backend API for Imprime template app",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts src/scripts/resetAdminPassword.ts src/scripts/demoteOtherAdmins.ts src/scripts/migrateTemplates.ts --bundle --platform=node --target=node18 --format=esm --outdir=dist --packages=external",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "admin:reset-password": "node dist/scripts/resetAdminPassword.js",
    "admin:reset-password:dev": "tsx src/scripts/resetAdminPassword.ts",
    "admin:demote-others": "node dist/scripts/demoteOtherAdmins.js",
    "admin:demote-others:dev": "tsx src/scripts/demoteOtherAdmins.ts",
    "migrate:templates": "node dist/scripts/migrateTemplates.js",
    "migrate:templates:dev": "tsx src/scripts/migrateTemplates.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.25",
    "@imprime/common": "*",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@react-pdf/renderer": "^4.3.2",
    "better-auth": "^1.6.25",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "fontkit": "^2.0.4",
    "helmet": "^8.3.0",
    "mongodb": "^6.20.0",
    "mongoose": "^8.9.5",
    "nodemailer": "^10.0.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
